# 模型接口（任意 OpenAI 兼容接口：OpenAI、DeepSeek、通义、智谱、本地 vLLM/Ollama 等）。
# 也可以启动后在网页「设置」里填写，设置会保存在本目录 settings.json（已在 .gitignore 中）。
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-chat

# 智能体可操作的根目录（绝对路径）。留空则使用启动目录
WORKSPACE_DIR=
PORT=5174

# 可选：OpenFOAM / MFIX 安装位置（不填则从 PATH 和常见位置自动查找）
FOAM_ROOT=
MFIX_ROOT=
