FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      thermophysicalProperties.water;
}

thermoType
{
    type     heRhoThermo;
    mixture  pureMixture;
    transport       const;
    thermo          eConst;
    equationOfState perfectFluid;
    specie   specie;
    energy   sensibleInternalEnergy;
}
mixture
{
    specie          { molWeight 18; }
    equationOfState { R 3000; rho0 998.2; }
    thermodynamics  { Cv 4195; Hf 0; }
    transport       { mu 1.0e-3; Pr 7.0; }
}
