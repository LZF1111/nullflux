FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      Theta;
}

dimensions      [0 2 -2 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    zone1_inlet
    {
        type                fixedValue;
        value               uniform 1e-7;
    }
    zone2_inlet
    {
        type                fixedValue;
        value               uniform 1e-7;
    }
    zone3_inlet
    {
        type                fixedValue;
        value               uniform 1e-7;
    }
    outlet
    {
        type                inletOutlet;
        inletValue          uniform 1e-7;
        value               uniform 1e-7;
    }
    walls
    {
        type                zeroGradient;
    }
    frontAndBack
    {
        type         empty;
    }
}
