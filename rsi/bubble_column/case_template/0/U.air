FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      U.air;
}

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{
    zone1_inlet
    {
        type         uniformFixedValue;
        uniformValue
 {
     type        tableFile;
     file "<constant>/zone1_U.dat";
     outOfBounds clamp;
        }
        value        uniform (0 0.02 0);
    }
    zone2_inlet
    {
        type         uniformFixedValue;
        uniformValue
 {
     type        tableFile;
     file "<constant>/zone2_U.dat";
     outOfBounds clamp;
        }
        value        uniform (0 0.02 0);
    }
    zone3_inlet
    {
        type         uniformFixedValue;
        uniformValue
 {
     type        tableFile;
     file "<constant>/zone3_U.dat";
     outOfBounds clamp;
        }
        value        uniform (0 0.02 0);
    }
    outlet
    {
        type                pressureInletOutletVelocity;
        phi                 phi.air;
        value               uniform (0 0 0);
    }
    walls
    {
        type                fixedValue;
        value               uniform (0 0 0);
    }
    frontAndBack
    {
        type         empty;
    }
}
