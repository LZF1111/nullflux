FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      km;
}

dimensions      [0 2 -2 0 0 0 0];

internalField   uniform 3.75e-5;

boundaryField
{
    zone1_inlet
    {
        type                fixedValue;
        value               $internalField;
    }
    zone2_inlet
    {
        type                fixedValue;
        value               $internalField;
    }
    zone3_inlet
    {
        type                fixedValue;
        value               $internalField;
    }
    outlet
    {
        type                inletOutlet;
        phi                 phim;
        inletValue          $internalField;
        value               $internalField;
    }
    walls
    {
        type                zeroGradient;
    }
    frontAndBack
    {
        type         empty;
    }
}
