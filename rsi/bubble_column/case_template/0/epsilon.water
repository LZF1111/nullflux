FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      epsilon.water;
}

dimensions      [0 2 -3 0 0 0 0];

internalField   uniform 1.5e-4;

boundaryField
{
    zone1_inlet
    {
        type                fixedValue;
        value               $internalField;
    }
    zone2_inlet
    {
        type                fixedValue;
        value               $internalField;
    }
    zone3_inlet
    {
        type                fixedValue;
        value               $internalField;
    }
    outlet
    {
        type                inletOutlet;
        phi                 phi.water;
        inletValue          $internalField;
        value               $internalField;
    }
    walls
    {
        type                epsilonWallFunction;
        value               $internalField;
    }
    frontAndBack
    {
        type         empty;
    }
}
