FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      alpha.air;
}

dimensions      [0 0 0 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    zone1_inlet
    {
        type         uniformFixedValue;
        uniformValue
 {
     type        tableFile;
     file "<constant>/zone1_alpha.dat";
     outOfBounds clamp;
        }
        value        uniform 0.5;
    }
    zone2_inlet
    {
        type         uniformFixedValue;
        uniformValue
 {
     type        tableFile;
     file "<constant>/zone2_alpha.dat";
     outOfBounds clamp;
        }
        value        uniform 0.5;
    }
    zone3_inlet
    {
        type         uniformFixedValue;
        uniformValue
 {
     type        tableFile;
     file "<constant>/zone3_alpha.dat";
     outOfBounds clamp;
        }
        value        uniform 0.5;
    }
    zone4_inlet
    {
        type         uniformFixedValue;
        uniformValue
 {
     type        tableFile;
     file "<constant>/zone4_alpha.dat";
     outOfBounds clamp;
        }
        value        uniform 0.5;
    }
    zone5_inlet
    {
        type         uniformFixedValue;
        uniformValue
 {
     type        tableFile;
     file "<constant>/zone5_alpha.dat";
     outOfBounds clamp;
        }
        value        uniform 0.5;
    }
    zone6_inlet
    {
        type         uniformFixedValue;
        uniformValue
 {
     type        tableFile;
     file "<constant>/zone6_alpha.dat";
     outOfBounds clamp;
        }
        value        uniform 0.5;
    }
    outlet
    {
        type                inletOutlet;
        phi                 phi.air;
        inletValue          uniform 1;
        value               uniform 1;
    }
    walls
    {
        type                zeroGradient;
    }
    frontAndBack
    {
        type         empty;
    }
}
