FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      p;
}

dimensions      [1 -1 -2 0 0 0 0];

internalField   uniform 1e5;

boundaryField
{
    zone1_inlet
    {
        type                calculated;
        value               $internalField;
    }
    zone2_inlet
    {
        type                calculated;
        value               $internalField;
    }
    zone3_inlet
    {
        type                calculated;
        value               $internalField;
    }
    outlet
    {
        type                calculated;
        value               $internalField;
    }
    walls
    {
        type                calculated;
        value               $internalField;
    }
}
