FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      U.water;
}

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{
    zone1_inlet
    {
        type                fixedValue;
        value               uniform (0 0 0);
    }
    zone2_inlet
    {
        type                fixedValue;
        value               uniform (0 0 0);
    }
    zone3_inlet
    {
        type                fixedValue;
        value               uniform (0 0 0);
    }
    outlet
    {
        type                pressureInletOutletVelocity;
        phi                 phi.water;
        value               uniform (0 0 0);
    }
    walls
    {
        type                fixedValue;
        value               uniform (0 0 0);
    }
}
