# in.lj_melt — LJ 单位最小可跑骨架（3D FCC 熔化，NVT）
# 运行: lmp -in in.lj_melt   (由用户本机 LAMMPS 执行)

# ---------- 1) 初始化 ----------
units           lj
dimension       3
boundary        p p p
atom_style      atomic

# ---------- 2) 建 FCC 晶格 + 原子 ----------
lattice         fcc 0.8442
region          box block 0 10 0 10 0 10
create_box      1 box
create_atoms    1 box
mass            1 1.0

# ---------- 3) 力场 ----------
pair_style      lj/cut 2.5
pair_coeff      1 1 1.0 1.0 2.5      # epsilon sigma cutoff

# ---------- 4) 邻居表 ----------
neighbor        0.3 bin
neigh_modify    delay 0 every 20 check no

# ---------- 5) 初速度 + 系综 ----------
velocity        all create 1.44 87287 mom yes rot yes dist gaussian
timestep        0.005                # LJ 典型步长
fix             1 all nvt temp 1.44 1.44 0.5

# ---------- 6) 输出 ----------
thermo          100
thermo_style    custom step temp pe ke etotal press
# dump          1 all custom 500 dump.lj id type x y z
# dump_modify   1 sort id

# ---------- 7) 运行 ----------
run             5000
