/*--------------------------------*- C++ -*----------------------------------*\
| OpenFOAM transportProperties 模板 — 不可压单相 Newton 流体                   |
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      transportProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

transportModel  Newtonian;

// 运动粘度 nu = mu/rho, dimensions [0 2 -1 0 0 0 0]
// 水 20°C ~1.0e-6 ; 空气 20°C ~1.5e-5
nu              1e-06;

// ************************************************************************* //
